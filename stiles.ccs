:root{
  --bg:#111;
  --fg:#fff;
  --accent: #1e90ff;
}
html,body{height:100%;margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,Segoe UI,Roboto,Helvetica,Arial;}
.slideshow{display:flex;align-items:center;justify-content:center;height:80vh;position:relative;max-width:100%;overflow:hidden;}
.frame{width:100%;max-width:1200px;position:relative;display:flex;align-items:center;justify-content:center;}
.frame img{max-width:70%;max-height:80vh;border-radius:6px;box-shadow:0 6px 18px rgba(0,0,0,.6);transition:opacity .6s ease;}
.caption{position:absolute;left:12px;bottom:12px;background:rgba(0,0,0,.45);padding:8px 12px;border-radius:6px;color:var(--fg);font-size:0.95rem;}
.nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.45);border:none;color:var(--fg);padding:12px;border-radius:50%;cursor:pointer;font-size:24px;}
.nav.left{left:8px;}
.nav.right{right:8px;}
.controls{padding:12px;color:var(--fg);display:flex;gap:12px;align-items:center;justify-content:center;}
button#fullscreen{background:var(--accent);color:#fff;border:0;padding:8px 12px;border-radius:6px;cursor:pointer;}
@media (max-width:600px){
  .caption{font-size:0.8rem;}
  .nav{padding:8px;font-size:20px;}
}
